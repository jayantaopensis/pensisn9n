# Copy this file to .env and fill in the values. Never commit .env.

# --- Web ---
# Port inside the container and on the host loopback. Point the reverse proxy
# at http://127.0.0.1:6700.
N8N_PORT=6700
N8N_HOST=n9n.almlengineer.cloud
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n9n.almlengineer.cloud/
N8N_WEBHOOK_URL=https://n9n.almlengineer.cloud/
N8N_PROXY_HOPS=1

# --- Security ---
# Encrypts saved credentials. Generate once with: openssl rand -hex 32
# Keep a backup. If you lose it, saved credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=

# --- Database ---
# If PostgreSQL runs on the same server, use host.docker.internal as the host.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=3005
DB_POSTGRESDB_DATABASE=opensis_n8n
DB_POSTGRESDB_USER=
DB_POSTGRESDB_PASSWORD=

# --- Time ---
# Used by schedule triggers. Example: Asia/Kolkata, Europe/London.
GENERIC_TIMEZONE=UTC
TZ=UTC
